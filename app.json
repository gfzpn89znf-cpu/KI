{
  "expo": {
    "name": "KI",
    "slug": "ki-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kiapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meineki.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Damit du der KI ein Foto schicken kannst.",
        "NSPhotoLibraryUsageDescription": "Damit du der KI Bilder aus deiner Galerie schicken kannst.",
        "NSMicrophoneUsageDescription": "Für Sprachaufnahmen in der App.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true,
        "com.apple.developer.kernel.extended-virtual-addressing": true
      }
    },
    "android": {
      "package": "com.meineki.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "KI",
      "shortName": "KI",
      "themeColor": "#0B0D10",
      "backgroundColor": "#0B0D10",
      "display": "standalone",
      "lang": "de"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du der KI Bilder aus deiner Galerie schicken kannst.",
          "cameraPermission": "Damit du der KI ein Foto schicken kannst."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": [
            "development",
            "preview",
            "production"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/KI"
    }
  }
}
